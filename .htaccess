# Compress text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/xml text/plain
</IfModule>

# Browser caching: hashed build files never change; images change rarely; HTML always revalidates
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Internal project files (docs, scripts, source media) live in the repo but are not part of the site
  RewriteRule ^_project/ - [F,L]
  # Repo housekeeping that Hostinger deploys alongside the site: dotfiles and dot-folders
  # (.github, .gitignore, .claude; .well-known stays reachable) and the dev tooling files
  RewriteRule ^\.(?!well-known/) - [F,L]
  RewriteRule ^(CLAUDE\.md|package(-lock)?\.json|serve\.mjs|screenshot\.mjs)$ - [F,L]
  RewriteRule ^index\.html$ - [L]

  # Redirect stale Squarespace URLs (still linked from Google Business Profile, old search results, socials)
  RewriteRule ^s/ohlala_menu-3\.pdf$ /ooh-la-la-menu.pdf [R=301,L]
  RewriteRule ^jobs/?$ /menu [R=301,L]

  # Prerendered pages (scripts/prerender.mjs): /menu serves menu.html, so crawlers that
  # don't run JavaScript (ChatGPT, Claude, Perplexity...) still get the page's real content
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]

  # Every other app route (/booking/manage, /loyalty, unknown URLs) gets the bare app shell.
  # Not index.html: that holds the prerendered home page, which would duplicate it on every URL.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /app.html [L]
</IfModule>
